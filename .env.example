# ==============================================================================
# StudentQuizz Fullstack - Docker Environment Configuration
# Copy file này thành .env trước khi chạy `docker compose up -d`
# ==============================================================================

# Database Settings
POSTGRES_DB=studentquizz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_PORT=5432

# Backend Settings
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_length_for_production
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Media / Image storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Settings
FRONTEND_PORT=80
